-- Schedule the simulator and the alert engine every minute.
-- Needs the pg_cron and pg_net extensions (Database → Extensions in the Supabase dashboard).
-- Replace <project-ref> and <CRON_SECRET>; set the same secret for the functions with
--   supabase secrets set CRON_SECRET=<CRON_SECRET>

-- Simulator (v1 only; remove when the real boat gateway is connected).
-- Each run writes telemetry every 3 s for ~57 s.
select cron.schedule('aquaq-simulator', '* * * * *', $$
  select net.http_post(
    url := 'https://<project-ref>.supabase.co/functions/v1/simulator',
    headers := jsonb_build_object('Content-Type', 'application/json', 'x-cron-secret', '<CRON_SECRET>'),
    body := '{"action":"tick"}'::jsonb,
    timeout_milliseconds := 70000
  );
$$);

-- Alert engine: rules, dedup, escalation and notifications (keep this in production).
select cron.schedule('aquaq-alerts', '* * * * *', $$
  select net.http_post(
    url := 'https://<project-ref>.supabase.co/functions/v1/alerts',
    headers := jsonb_build_object('Content-Type', 'application/json', 'x-cron-secret', '<CRON_SECRET>'),
    body := '{"action":"evaluate"}'::jsonb,
    timeout_milliseconds := 30000
  );
$$);

-- To stop: select cron.unschedule('aquaq-simulator'); select cron.unschedule('aquaq-alerts');
