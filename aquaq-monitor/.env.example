# "demo" runs fully in the browser (seeded demo lake + in-browser simulator, no backend needed).
# "supabase" uses the Supabase project below.
VITE_DATA_SOURCE=demo

# Public (anon) values only. Never put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public VAPID key for web push. The private key is an Edge Function secret (VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=

# Used only by scripts/seed-supabase.ts, run from your machine. Never shipped to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secrets (supabase secrets set ...), never VITE_ variables:
# CRON_SECRET, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT,
# EMAIL_WEBHOOK_URL, SMS_WEBHOOK_URL, PLANNER_API_KEY
